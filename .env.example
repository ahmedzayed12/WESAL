# انسخ هذا الملف إلى .env وعدّل القيم قبل التشغيل: cp .env.example .env
# النطاق الرئيسي للمنصة ونطاق الوسائط (يجب أن يشير كلاهما إلى عنوان IP الخادم في DNS)
APP_DOMAIN=wesal.example.com
MEDIA_DOMAIN=media.wesal.example.com

# كلمات مرور قوية: openssl rand -base64 32
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=wesal-admin
MINIO_ROOT_PASSWORD=change-me-too

# عدد نسخ خادم التطبيق (كل نسخة تستخدم نواة معالج واحدة تقريبًا)
APP_REPLICAS=2
DATABASE_POOL_MAX=15
MAX_IMAGE_MB=10
MAX_VIDEO_MB=100

# ضبط الذاكرة لخادم بذاكرة 4GB (اجعل shared_buffers نحو ربع الذاكرة)
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE=3GB
REDIS_MAXMEMORY=256mb
